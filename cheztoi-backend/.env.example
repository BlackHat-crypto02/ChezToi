# Copier ce fichier vers .env puis ajuster.
SECRET_KEY=dev-secret-a-changer-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Origines autorisées à appeler l'API (Next.js, Flutter web...).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite pour commencer ; passer à PostgreSQL plus tard si besoin.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Invitation des administrateurs : lien envoyé par e-mail (valable 24 h).
APP_BASE_URL=http://127.0.0.1:3000
# Par défaut en DEBUG, les e-mails sont affichés dans la console (pas envoyés).
# En production :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.tg
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@cheztoi.tg
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ChezToi <no-reply@cheztoi.tg>
